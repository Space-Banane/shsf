# API server port
PORT=5000

# Database connection string (MariaDB/MySQL)
DATABASE_URL=mysql://user:password@db:3306/shsf

# Cookie domain. Use "localhost" locally; set your real hostname (e.g. shsf.example.com) when deploying.
DOMAIN=localhost

# Public UI URL
UI_URL=http://localhost:5000

# API URL for the UI to connect to
REACT_APP_API_URL=http://localhost:5000

# Comma-separated list of allowed CORS origins
CORS_URLS=http://localhost:5000

# Rate limit in milliseconds
RATELIMIT=5000

# Instance secret — used to encrypt sensitive data such as git passwords at rest.
# Production requires at least 32 characters and rejects the built-in default. Generate with:
#   openssl rand -hex 32
INSTANCE_SECRET=

# Enable only for a public, disposable demo instance. Seeds demo@shsf.local
# with password demo-password plus a runnable sample function.
IS_DEMO=false

# Optional OpenID Connect sign-in. See docs/sso.md for claims, groups, roles and expiry.
SSO_ENABLED=false
SSO_LOCAL_LOGIN_ENABLED=true
# SSO_NAME=Company sign-in
# SSO_ISSUER=https://identity.example.com/realms/company
# SSO_CLIENT_ID=shsf
# SSO_CLIENT_SECRET=replace-with-your-client-secret
# SSO_SCOPES=openid email profile groups roles
# SSO_GROUP_MAPPING={"immutable-provider-group-id":"Engineering"}
# SSO_ADMIN_ROLES=["shsf-administrators-role-id"]
# SSO_SESSION_SECONDS=300
# SSO_TIMEOUT_SECONDS=5
# NODE_EXTRA_CA_CERTS=/run/secrets/company-ca.pem
