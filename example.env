# API server port
PORT=5000

# Database connection string (MariaDB/MySQL)
DATABASE_URL=mysql://user:password@db:3306/shsf

# Cookie domain. Use "localhost" locally; set your real hostname (e.g. shsf.example.com) when deploying.
DOMAIN=localhost

# Public UI URL
UI_URL=http://localhost:5000

# API URL for the UI to connect to
REACT_APP_API_URL=http://localhost:5000

# Comma-separated list of allowed CORS origins
CORS_URLS=http://localhost:5000

# Rate limit in milliseconds
RATELIMIT=5000

# Instance secret — used to encrypt sensitive data such as git passwords at rest.
# Production requires at least 32 characters and rejects the built-in default. Generate with:
#   openssl rand -hex 32
INSTANCE_SECRET=

# Enable only for a public, disposable demo instance. Seeds demo@shsf.local
# with password demo-password plus a runnable sample function.
IS_DEMO=false

# --- In-app updater (all optional) -------------------------------------------
# By default the tracked image and the Compose layout are read from this
# container's own labels. Set these for custom layouts or private registries.
# All paths are HOST paths and must be inside UPDATE_COMPOSE_PROJECT_DIR.
#UPDATE_IMAGE=registry.reversed.dev/shsf/core:prod
#UPDATE_HELPER_IMAGE=docker:28-cli
#UPDATE_REGISTRY_USERNAME=
#UPDATE_REGISTRY_PASSWORD=
#UPDATE_REGISTRY_SERVER=
#UPDATE_COMPOSE_PROJECT=shsf
#UPDATE_COMPOSE_SERVICE=backend
#UPDATE_COMPOSE_PROJECT_DIR=/srv/shsf
#UPDATE_COMPOSE_FILES=/srv/shsf/docker-compose.yml,/srv/shsf/docker-compose.override.yml
#UPDATE_COMPOSE_ENV_FILES=/srv/shsf/.env
