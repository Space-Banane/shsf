generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  Admin
  User
}

enum InstanceSettingType {
  instance_uuid
  registration_disabled
  link_lock
  guest_access_disabled
  external_access_disabled
  disabled_images
  link_status
  auto_update_enabled
  update_last_check
  allow_ai_provider_internal
}

model InstanceSetting {
  type      InstanceSettingType @id
  value     String              @db.Text
  updatedAt DateTime            @updatedAt
}

model User {
  id          Int      @id @default(autoincrement())
  displayName String   @db.VarChar(128)
  email       String   @unique
  role        UserRole @default(User)

  password String? @db.VarChar(256)

  openRouterKey String? @db.VarChar(512) // Legacy plaintext key; migrated on next save
  aiProviderEndpoint String? @db.VarChar(1024)
  aiProviderModel String? @db.VarChar(256)
  aiProviderApiKey String? @db.Text
  aiProviderCapabilities String? @db.Text
  account_env   String? @db.Text // Account-wide environment variables in JSON format

  // Opt-in OpenRouter Decisions log analysis. Off by default; no model is assumed.
  logAnalysisEnabled Boolean @default(false)
  logAnalysisModel   String? @db.VarChar(256)

  allow_docker_mount Boolean @default(false) // Admin-controlled: whether this user may create functions with docker socket mount

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  functions    Function[]
  namespaces   Namespace[]
  accessTokens AccessToken[]
  storages     FunctionStorage[]
  guestUsers   GuestUser[]
  groupMemberships GroupMember[]
  receivedShares   ResourceShare[] @relation("ShareRecipient")
}

model Session {
  id   Int    @id @default(autoincrement())
  hash String @db.Text

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Function {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(128)
  description String @db.VarChar(256)
  image       String @db.VarChar(256)

  executionId String @unique @db.VarChar(256) // Unique identifier for the function execution
  executionAlias String? @db.VarChar(128) @unique // Human-readable alias for the function execution

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  max_ram       Int     @default(512)
  timeout       Int     @default(15)
  allow_http    Boolean @default(true)
  env           String? @db.Text // Environment variables in JSON format (comma separated key=value pairs)
  secure_header String? @db.VarChar(256)

  retry_on_failure Boolean @default(false)
  max_retries      Int     @default(3)

  tags         String? @db.Text // comma separated tags
  startup_file String @db.VarChar(256) // Replaced startup_command with startup_file
  cors_origins String? @db.Text // Comma separated list of allowed CORS origins

  // Extra Cool shit
  docker_mount Boolean @default(false) // Whether to mount a Docker socket
  network_restricted Boolean @default(false) // Whether to disable network access for the function container
  ffmpeg_install Boolean @default(false) // Whether to install ffmpeg in the function environment
  opencv_install Boolean @default(false) // Whether to install opencv in the function environment

  // Git Version Control
  git_url              String?  @db.VarChar(1024) // Git repository URL for version control (without credentials)
  git_username         String?  @db.VarChar(256)  // Git username for private repos
  git_password         String?  @db.VarChar(512)  // Git password / access token for private repos
  git_periodic_pull    Boolean  @default(false)    // Whether to pull periodically
  git_pull_interval    Int      @default(10)       // Periodic pull interval in minutes
  git_source_dir       String?  @db.VarChar(512)   // Optional subdirectory within the repo to use as the function source
  git_branch           String?  @db.VarChar(256)   // Git branch to use for version control

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastRun   DateTime? // Last time the function was executed

  namespaceId Int
  namespace   Namespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  logging String? @db.Text // Logging Configuration JSON Stringified
  ratelimit String? @db.Text // Execution rate limit configuration JSON stringified


  // System Manged Data
  guest_access Boolean @default(false) // Whether guest users can access this function, will be kept in sync with GuestUser permissions, when changed
  imported     Boolean @default(false) // Marks whether the function was created via import
  ai_kicked_off Boolean @default(false) // Marks whether the function was created via AI kickoff

  // Caching
  cache_enabled Boolean @default(false)
  cache_ttl     Int     @default(60) // TTL in seconds

  files      FunctionFile[]
  folders    FunctionFolder[]
  triggers   FunctionTrigger[]
  TriggerLog TriggerLog[]
  caches     FunctionCache[]
  shares     ResourceShare[]
}

model FunctionCache {
  id         Int      @id @default(autoincrement())
  functionId Int
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  hash       String   @db.VarChar(256) // Hash of the payload
  result     String   @db.Text        // Cached result (JSON string)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([functionId, hash])
  @@index([expiresAt])
}

model FunctionFile {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(256)
  content String @db.Text

  functionId Int
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FunctionFolder {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(256)

  functionId Int
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([functionId, name])
}

model Namespace {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(128)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  functions Function[]
  shares    ResourceShare[]
}

model FunctionTrigger {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(128)
  description String @db.VarChar(256)
  cron        String @db.VarChar(128) // Cron expression for scheduling
  data        Json?

  enabled Boolean @default(true)

  functionId Int
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastRun   DateTime? // Last time the trigger was executed
  lastRunSuccessful Boolean? // Whether the most recent execution exited successfully
  nextRun   DateTime? // Next time the trigger is scheduled to run
}

model TriggerLog {
  id         Int      @id @default(autoincrement())
  functionId Int
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  result     String?  @db.Text // Result of the function execution
  logs       String   @db.Text // Logs from the function execution

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis LogAnalysis?
}

enum LogAnalysisStatus {
  pending
  running
  completed
  skipped
  failed
  disabled
}

// Advisory OpenRouter Decisions result for one TriggerLog. Never rewrites the log's own result.
model LogAnalysis {
  id           Int        @id @default(autoincrement())
  triggerLogId Int        @unique
  triggerLog   TriggerLog @relation(fields: [triggerLogId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status        LogAnalysisStatus @default(pending)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  model         String            @db.VarChar(256) // Configured model at enqueue time
  inputVersion  Int?              // Sanitizer/request version
  inputHash     String?           @db.VarChar(64) // sha256 of the sanitized request state

  failureProbability  Float?
  failureDetected     Boolean?
  attentionPriority   Int? // 1-10
  attentionConfidence Float?
  decision            Json? // Raw typed answers as returned by the Decisions API
  providerModel       String? @db.VarChar(256)
  costUsd             Float?
  inputTokens         Int?
  outputTokens        Int?
  error               String? @db.VarChar(512)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model AccessToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(256)
  name      String    @db.VarChar(128)
  purpose   String?   @db.VarChar(512)
  
  expiresAt DateTime?
  expired   Boolean   @default(false)
  hidden    Boolean   @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FunctionStorage {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(128)
  purpose    String @db.VarChar(256)

  user Int
  userRel User @relation(fields: [user], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  FunctionStorageItem[]
  shares ResourceShare[]
}

model FunctionStorageItem {
  id               Int    @id @default(autoincrement())
  key              String @db.VarChar(256)
  value            String @db.Text

  storageId Int
  storage   FunctionStorage @relation(fields: [storageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuestUser {
  id         Int      @id @default(autoincrement())
  displayName String   @db.VarChar(128)
  email       String   @unique

  permittedFunctions Json // List of numeric Function IDs (database IDs) the guest user is permitted to access  
  password_hash String @db.VarChar(256)

  guestOwnerId Int
  guestOwner   User @relation(fields: [guestOwnerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions GuestSession[]
}

model GuestSession {
  id   Int    @id @default(autoincrement())
  hash String @db.Text

  guestUserId Int
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

enum SharePermission {
  view
  execute
  edit
}

enum GroupMemberSource {
  local
  sso
}

// Admin-managed user group. SSO groups (#65) map onto a local group through
// (ssoProvider, ssoGroupId); grants always reference Group.id, so disabling SSO
// leaves groups and shares intact.
model Group {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(128)
  description String? @db.VarChar(256)

  ssoProvider String? @db.VarChar(128)
  ssoGroupId  String? @db.VarChar(256)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]
  shares  ResourceShare[]

  @@unique([ssoProvider, ssoGroupId])
}

model GroupMember {
  groupId Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  source  GroupMemberSource @default(local)

  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// One grant: exactly one resource (namespace, function, or storage) shared with
// exactly one recipient (user or group). Namespace grants apply to every
// function in the namespace. Ownership never moves.
model ResourceShare {
  id Int @id @default(autoincrement())

  namespaceId Int?
  namespace   Namespace?       @relation(fields: [namespaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  functionId  Int?
  function    Function?        @relation(fields: [functionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  storageId   Int?
  storage     FunctionStorage? @relation(fields: [storageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  userId  Int?
  user    User?  @relation("ShareRecipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  groupId Int?
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  permission SharePermission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespaceId, userId])
  @@unique([namespaceId, groupId])
  @@unique([functionId, userId])
  @@unique([functionId, groupId])
  @@unique([storageId, userId])
  @@unique([storageId, groupId])
}

// Security-relevant changes (group membership, shares). Never store secrets here.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int? // No FK: entries outlive deleted users
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32)
  targetId   Int?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum UpdateOperationStatus {
  running
  completed
  failed
  cancelled
  rolled_back
}

enum UpdateOperationPhase {
  preflight
  pull
  replacement
  migration
  verification
  completion
  rollback
  failure
}

// Durable record of one self-update. Survives the restart that the update
// itself causes; see Backend/src/lib/Updater.ts.
model UpdateOperation {
  id      String                @id @default(uuid()) @db.VarChar(36)
  status  UpdateOperationStatus @default(running)
  phase   UpdateOperationPhase  @default(preflight)
  trigger String                @db.VarChar(16) // manual | auto

  imageRef    String? @db.VarChar(512) // Tracked image reference that was pulled
  fromImageId String? @db.VarChar(80)
  fromDigest  String? @db.VarChar(255)
  toImageId   String? @db.VarChar(80)
  toDigest    String? @db.VarChar(255)

  helperContainerId String? @db.VarChar(80)
  exitCode          Int?
  error             String? @db.Text
  log               String? @db.Text // Backend-side progress lines
  helperOutput      String? @db.Text // Captured stdout/stderr of the helper container

  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?
  deadlineAt DateTime

  @@index([status])
  @@index([startedAt])
}
