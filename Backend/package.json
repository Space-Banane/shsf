{
	"version": "2.0.1",
	"name": "shsf-backend",
	"description": "Backend for SHSF",
	"private": true,
	"license": "MIT-0",
	"dependencies": {
		"@openrouter/sdk": "^0.8.0",
		"@prisma/client": "^6.19.3",
		"@rjweb/runtime-node": "^1.1.1",
		"@rjweb/utils": "^1.12.29",
		"@types/bcrypt": "^5.0.2",
		"@types/dockerode": "^3.3.47",
		"@types/node": "^22.19.15",
		"@types/nodemailer": "^6.4.23",
		"@vitest/coverage-v8": "^4.1.2",
		"axios": "^1.14.0",
		"bcrypt": "^5.1.1",
		"cron-parser": "^5.5.0",
		"dockerode": "^4.0.10",
		"dotenv": "17.2.3",
		"esbuild": "^0.25.12",
		"file-type": "^19.6.0",
		"lru-cache": "^11.2.7",
		"prisma": "^6.19.3",
		"rjweb-server": "^9.8.6",
		"tar": "^7.5.13",
		"typescript": "^5.9.3",
		"vitest": "^4.1.2"
	},
	"scripts": {
		"prism": "npx prisma generate && npx prisma db push",
		"generate": "npx prisma generate",
		"build": "rm -rf dist && tsc",
		"start": "cd dist && node index.js",
		"prod": "pnpm build && pnpm start",
		"dev": "rm -rf dist && esbuild `find src \\( -name '*.ts' -o -name '*.tsx' \\)` --platform='node' --sourcemap --ignore-annotations --format='cjs' --target='es2022' --outdir='dist' && cd dist && node index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	}
}