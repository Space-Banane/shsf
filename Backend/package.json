{
	"version": "2.1.0",
	"name": "shsf-backend",
	"description": "Backend for SHSF",
	"private": true,
	"license": "MIT-0",
	"dependencies": {
		"@openrouter/sdk": "^1.4.25",
		"@prisma/adapter-mariadb": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@rjweb/runtime-node": "^1.1.3",
		"@rjweb/utils": "^1.12.29",
		"axios": "^1.20.0",
		"bcrypt": "^6.0.0",
		"cron-parser": "5.10.1",
		"dockerode": "^5.0.1",
		"dotenv": "18.0.6",
		"file-type": "^22.1.1",
		"lru-cache": "^11.5.3",
		"mariadb": "^3.5.4",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"prisma": "^7.10.0",
		"rjweb-server": "^9.9.1",
		"tar": "^7.5.22",
		"zod": "^4.6.5"
	},
	"scripts": {
		"migrate": "npx prisma migrate dev",
		"migrate:deploy": "npx prisma migrate deploy",
		"generate": "npx prisma generate",
		"build": "rimraf dist && tsc",
		"start": "cd dist && node index.js",
		"prod": "pnpm build && pnpm start",
		"dev": "rimraf dist && esbuild \"src/**/*.ts\" --platform=node --sourcemap --ignore-annotations --format=cjs --target=es2022 --outdir=dist && cd dist && node index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/dockerode": "^4.0.1",
		"@types/node": "^26.6.4",
		"@types/nodemailer": "^8.0.2",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	}
}
